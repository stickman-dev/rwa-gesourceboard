{
  "id": "rwa-gesourceboard",
  "repository": "stickman-dev/rwa-gesourceboard",
  "version": "0.1.0",
  "compatibleGames": "all",
  "compatibleSizes": [
    "large",
    "medium"
  ],
  "options": {
    "quickMaps": {
      "type": "text",
      "default": "ge_archives_classic,ge_bunker_classic,ge_complex_classic,ge_library_classic,ge_stack_classic,ge_temple_classic,ge_facility_classic,ge_basement_classic"
    },
    "quickConfigs": {
      "type": "text",
      "default": "server_n64_classic.cfg,server_normal.cfg,server_dm_only.cfg,server_teamplay.cfg"
    },
    "quickWeaponSets": {
      "type": "text",
      "default": "assorted_weapons,rockets,throwing_knives,golden_guns,slappers,proximity_mines,explosives"
    },
    "quickGameplays": {
      "type": "text",
      "default": "arsenal,capturetheflag,deathmatch,drnoarmor,guntrade,livingdaylights,ltk,mwgg,viewtoakill,yolt"
    }
  },
  "locale": {
    "en": {
      "name": "GE:Sourceboard",
      "description": "Quick administration controls for GoldenEye: Source servers.",
      "input.cmd": "Execute a RCON command, press Enter",
      "cmd.raw": "Run RCON command",
      "cmd.changelevel": "Change map",
      "cmd.exec": "Load config",
      "maps.title": "Maps",
      "configs.title": "Server Presets",
      "commands.title": "RCON Command",
      "serverstatus": "Server Status",
      "output.title": "RCON Output",
      "option.quickMaps.title": "Quick maps",
      "option.quickMaps.info": "Comma-separated map names, without .bsp",
      "option.quickConfigs.title": "Quick server presets",
      "option.quickConfigs.info": "Comma-separated cfg files used as server presets",
      "option.quickWeaponSets.title": "Quick weapon sets",
      "option.quickWeaponSets.info": "Comma-separated GE:S weapon-set identities",
      "option.quickGameplays.title": "Quick gameplay modes",
      "option.quickGameplays.info": "Comma-separated GE:S gameplay identities"
    }
  }
}
